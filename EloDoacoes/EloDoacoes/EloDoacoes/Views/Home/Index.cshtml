@model EloDoacoes.ViewModels.HomeIndexViewModel

@{
    ViewData["Title"] = "Feed de Doações";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-primary mb-1">Feed de Doações</h1>
            <p class="text-secondary mb-0">Explore os itens disponíveis para doação e faça sua reserva.</p>
        </div>
        <a asp-controller="Donations" asp-action="Create" class="btn btn-primary shadow-sm">
            Quero Doar
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    @* Search and Filter UI Section *@
    <div class="card border-0 shadow-sm rounded-3 p-3 p-md-4 mb-4 bg-white">
        <form asp-action="Index" method="get">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-5">
                    <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control shadow-sm" placeholder="Buscar por título, descrição ou categoria..." />
                </div>
                <div class="col-12 col-md-3">
                    <select name="sortOrder" class="form-control shadow-sm">
                        @if (ViewData["CurrentSort"] as string == "date_desc" || ViewData["CurrentSort"] == null)
                        {
                            <option value="date_desc" selected>Mais Recentes</option>
                        }
                        else
                        {
                            <option value="date_desc">Mais Recentes</option>
                        }

                        @if (ViewData["CurrentSort"] as string == "date_asc")
                        {
                            <option value="date_asc" selected>Mais Antigos</option>
                        }
                        else
                        {
                            <option value="date_asc">Mais Antigos</option>
                        }

                        @if (ViewData["CurrentSort"] as string == "title_asc")
                        {
                            <option value="title_asc" selected>Título (A-Z)</option>
                        }
                        else
                        {
                            <option value="title_asc">Título (A-Z)</option>
                        }

                        @if (ViewData["CurrentSort"] as string == "title_desc")
                        {
                            <option value="title_desc" selected>Título (Z-A)</option>
                        }
                        else
                        {
                            <option value="title_desc">Título (Z-A)</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary fw-bold px-4 shadow-sm flex-grow-1">
                        Buscar / Filtrar
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-3 shadow-sm">
                        Limpar Filtros
                    </a>
                </div>
            </div>
        </form>
    </div>

    @if (Model == null || Model.Items == null || !Model.Items.Any())
    {
        <div class="card border-0 shadow-sm rounded-3 text-center p-5 my-4">
            <div class="py-4">
                <h4 class="fw-bold text-secondary mb-3">Nenhuma doação disponível no feed</h4>
                <p class="text-muted mb-4">No momento não há novos itens disponíveis para adoção. Seja o primeiro a cadastrar uma doação!</p>
                <a asp-controller="Donations" asp-action="Create" class="btn btn-primary btn-lg px-4">
                    Cadastrar Doação
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4 mb-5 justify-content-start">
            @foreach (var donation in Model.Items)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <partial name="_DonationCard" model="donation" />
                </div>
            }
        </div>

        @* Include pagination component *@
        <partial name="_PaginationPartial" model="Model" />
    }
</div>
