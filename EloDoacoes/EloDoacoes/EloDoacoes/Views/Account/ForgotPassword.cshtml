@{
    ViewData["Title"] = "Recuperação de Senha";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 p-4 p-md-5">
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-primary mb-1">Recuperação de Senha</h2>
                    <p class="text-secondary small mb-0">Instruções para redefinir o acesso à sua conta</p>
                </div>

                <div class="alert alert-warning border-0 shadow-sm rounded-3 p-4 mb-4">
                    <h5 class="fw-bold text-dark mb-2"><i class="bi bi-info-circle-fill me-2"></i>Aviso Importante</h5>
                    <p class="mb-2">A redefinição automática por e-mail está em fase de manutenção no servidor.</p>
                    <p class="mb-2">Caso necessite redefinir sua senha imediatamente, envie uma solicitação para nossa equipe de suporte:</p>
                    <p class="mb-0 fw-bold text-dark">suporte@elodoacoes.com</p>
                </div>

                <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                    <a class="btn btn-primary px-4 py-2 fw-bold shadow-sm"
                       href="mailto:suporte@elodoacoes.com?subject=Recuperação de senha - Elo Doações&body=Nome:%0D%0AE-mail cadastrado:%0D%0ADescreva sua solicitação:">
                        Solicitar por E-mail
                    </a>
                    <a asp-action="Login" class="btn btn-outline-secondary px-4 py-2">
                        Voltar para Login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>