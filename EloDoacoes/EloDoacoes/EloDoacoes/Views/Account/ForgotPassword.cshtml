@{
    ViewData["Title"] = "Recuperação de Senha";
}

<div class="row justify-content-center">

    <div class="col-md-7">

        <h2 class="mb-4">
            Recuperação de Senha
        </h2>

        <div class="alert alert-warning">

            <h5>Esqueceu sua senha?</h5>

            <p>
                A recuperação automática ainda não está disponível.
            </p>

            <p>
                Caso necessite redefinir sua senha, envie um e-mail para:
            </p>

            <p class="mb-0">
                <strong>suporte@elodoacoes.com</strong>
            </p>

        </div>

        <a class="btn btn-primary"
           href="mailto:suporte@elodoacoes.com?subject=Recuperação de senha - Elo Doações&body=Nome:%0D%0AE-mail cadastrado:%0D%0ADescreva sua solicitação:">
            Enviar e-mail
        </a>

        <a asp-action="Login"
           class="btn btn-outline-secondary">

            Voltar

        </a>

    </div>

</div>