@model EloDoacoes.Models.Donation

@{
    ViewData["Title"] = "Excluir Doação";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-danger mb-1">Excluir Doação</h1>
            <p class="text-secondary mb-0">Confirme se deseja realmente remover este item do sistema.</p>
        </div>
        <a asp-action="MyDonations" class="btn btn-outline-secondary">
            Voltar para Minhas Doações
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card border-danger shadow-sm rounded-3 overflow-hidden">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Atenção: Ação Irreversível</h5>
                </div>
                <div class="card-body p-4 p-md-5">
                    <p class="lead text-dark mb-4">Tem certeza que deseja excluir permanentemente a doação abaixo?</p>

                    <div class="bg-light p-4 rounded-3 border mb-4">
                        <dl class="row mb-0">
                            <dt class="col-sm-3 text-secondary">Título:</dt>
                            <dd class="col-sm-9 fw-bold text-dark">@Html.DisplayFor(model => model.Title)</dd>

                            <dt class="col-sm-3 text-secondary">Descrição:</dt>
                            <dd class="col-sm-9 text-dark">@Html.DisplayFor(model => model.Description)</dd>

                            <dt class="col-sm-3 text-secondary">Categoria:</dt>
                            <dd class="col-sm-9 text-dark">@(Model.Category?.Name ?? "Geral")</dd>

                            <dt class="col-sm-3 text-secondary">Data de Registro:</dt>
                            <dd class="col-sm-9 text-dark">@Model.RegistrationDate.ToShortDateString()</dd>
                        </dl>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="DonationID" />
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="MyDonations" class="btn btn-outline-secondary px-4">
                                Cancelar
                            </a>
                            <button type="submit" class="btn btn-danger px-4 fw-bold shadow-sm">
                                Confirmar Exclusão
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
