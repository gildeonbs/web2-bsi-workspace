@using System.Linq
@model IEnumerable<EloDoacoes.Models.Donation>

@{
    ViewData["Title"] = "Minhas Doações";
}

@{
    var defaultImgUrl = Url.Content("~/images/default-donation.svg");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@ViewData["Title"]</h1>
</div>

<p class="mb-4">
    <a asp-action="Create" class="text-decoration-none">Criar Nova Doação</a>
</p>

<div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
    @foreach (var item in Model) {
        <div class="col mb-4">
            <div class="card h-100 shadow-sm border-0 rounded-3 p-0" style="overflow:hidden;">

                @{ 
                    var firstImg = (item.DonationImages != null && item.DonationImages.Any())
                        ? item.DonationImages.OrderBy(i => i.DisplayOrder).FirstOrDefault()
                        : null;
                }

                <div style="height: 160px; background-color: #d1d1d1; display: flex; align-items: center; justify-content: center; border-radius: 0.375rem 0.375rem 0 0; overflow: hidden;">
                    <a asp-action="Details" asp-route-id="@item.DonationID" class="d-flex align-items-center justify-content-center" style="display:block; width:100%; height:100%;">
                        @if (firstImg != null && firstImg.ImageData != null && firstImg.ImageData.Length > 0)
                        {
                            <img src="data:@firstImg.ContentType;base64,@System.Convert.ToBase64String(firstImg.ImageData)" alt="@firstImg.FileName" style="width: 100%; height: 100%; object-fit: cover; display:block;" />
                        }
                        else
                        {
                            <img src="@defaultImgUrl" alt="Sem imagem" style="width:64px; height:64px; object-fit:contain; display:block;" />
                        }
                    </a>
                </div>

                <div class="card-body">
                    <h6 class="card-title fw-bold mb-1">@Html.DisplayFor(modelItem => item.Title)</h6>
                    <p class="card-text small mb-1 text-truncate">@Html.DisplayFor(modelItem => item.Description)</p>
                    <p class="card-text small text-dark">
                        Data de registro: @item.RegistrationDate.ToShortDateString()
                    </p>
                </div>

                <div class="card-footer bg-white border-top-0 pt-0 text-center pb-3">
                    <hr class="mt-0 mb-2" style="border-top: 1px solid #ccc;">
                    <a asp-action="Edit" asp-route-id="@item.DonationID" class="text-decoration-none">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.DonationID" class="text-decoration-none">Detalhes</a> |
                    <a asp-action="Delete" asp-route-id="@item.DonationID" class="text-decoration-none">Excluir</a>
                </div>

            </div>
        </div>
    }
</div>
