@using System.Linq
@model IEnumerable<EloDoacoes.Models.Donation>

@{
    ViewData["Title"] = "Catálogo de Doações";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-primary mb-1">Catálogo de Doações</h1>
            <p class="text-secondary mb-0">Visualize e gerencie todas as doações cadastradas.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            Criar Nova Doação
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    @* Search and Filter UI Section *@
    <div class="card border-0 shadow-sm rounded-3 p-3 p-md-4 mb-4 bg-white">
        <form asp-action="Index" method="get">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-5">
                    <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control shadow-sm" placeholder="Buscar por título, descrição ou categoria..." />
                </div>
                <div class="col-12 col-md-3">
                    <select name="sortOrder" class="form-control shadow-sm">
                        @if (ViewData["CurrentSort"] as string == "date_desc" || ViewData["CurrentSort"] == null)
                        {
                            <option value="date_desc" selected>Mais Recentes</option>
                        }
                        else
                        {
                            <option value="date_desc">Mais Recentes</option>
                        }

                        @if (ViewData["CurrentSort"] as string == "date_asc")
                        {
                            <option value="date_asc" selected>Mais Antigos</option>
                        }
                        else
                        {
                            <option value="date_asc">Mais Antigos</option>
                        }

                        @if (ViewData["CurrentSort"] as string == "title_asc")
                        {
                            <option value="title_asc" selected>Título (A-Z)</option>
                        }
                        else
                        {
                            <option value="title_asc">Título (A-Z)</option>
                        }

                        @if (ViewData["CurrentSort"] as string == "title_desc")
                        {
                            <option value="title_desc" selected>Título (Z-A)</option>
                        }
                        else
                        {
                            <option value="title_desc">Título (Z-A)</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary fw-bold px-4 shadow-sm flex-grow-1">
                        Buscar
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-3 shadow-sm">
                        Limpar Filtros
                    </a>
                </div>
            </div>
        </form>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-3 text-center p-5 my-4">
            <div class="py-4">
                <h4 class="fw-bold text-secondary mb-3">Nenhuma doação cadastrada</h4>
                <p class="text-muted mb-4">Ainda não há itens registrados nesta lista. Clique abaixo para cadastrar a primeira doação!</p>
                <a asp-action="Create" class="btn btn-primary btn-lg px-4">
                    Criar Nova Doação
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4 mb-5 justify-content-start">
            @foreach (var item in Model)
            {
                var firstImg = (item.DonationImages != null && item.DonationImages.Any())
                    ? item.DonationImages.OrderBy(i => i.DisplayOrder).FirstOrDefault()
                    : null;

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow border-0 rounded-3 overflow-hidden donation-card">
                        <a asp-action="Details" asp-route-id="@item.DonationID" class="text-decoration-none d-block">
                            @if (firstImg != null && firstImg.ImageData != null && firstImg.ImageData.Length > 0)
                            {
                                <img src="data:@firstImg.ContentType;base64,@System.Convert.ToBase64String(firstImg.ImageData)" class="card-img-top" style="height: 210px; object-fit: cover;" alt="@firstImg.FileName" />
                            }
                            else
                            {
                                <img src="~/images/default-donation.svg" class="card-img-top p-4 bg-light" style="height: 210px; object-fit: contain;" alt="Sem imagem" />
                            }
                        </a>
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-primary">@(item.Category?.Name ?? "Geral")</span>
                                <span class="badge bg-light text-dark border">@item.RegistrationDate.ToShortDateString()</span>
                            </div>

                            <h5 class="card-title fw-bold mb-2">
                                <a asp-action="Details" asp-route-id="@item.DonationID" class="text-decoration-none text-primary">
                                    @item.Title
                                </a>
                            </h5>

                            <p class="card-text text-secondary flex-grow-1 mb-3">@item.Description</p>

                            <div class="mt-auto pt-3 border-top d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@item.DonationID" class="btn btn-outline-warning flex-grow-1">
                                    Editar
                                </a>
                                <a asp-action="Details" asp-route-id="@item.DonationID" class="btn btn-outline-primary flex-grow-1">
                                    Detalhes
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.DonationID" class="btn btn-outline-danger">
                                    Excluir
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
