@model EloDoacoes.ViewModels.MyDonationsViewModel

@{
    ViewData["Title"] = "Minhas Doações";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@ViewData["Title"]</h1>
    <p class="mb-0">
        <a asp-action="Create" class="btn btn-sm btn-success">Criar Nova Doação</a>
    </p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (Model == null || Model.Items == null || !Model.Items.Any())
{
    <div class="alert alert-info">Você ainda não possui doações cadastradas.</div>
}
else
{
    <div class="row g-4 mb-5 justify-content-start">
        @foreach (var donation in Model.Items)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <partial name="_DonationCard" model="donation" />
            </div>
        }
    </div>

    @* Include pagination component *@
    <partial name="_PaginationPartial" model="Model" />
}
