@model EloDoacoes.Models.Donation

@{
    ViewData["Title"] = "Editar Doação";
}

<h1>Editar Doação</h1>

<h4>Doação</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="DonationID" />
            <div class="form-group">
                <label asp-for="Title" class="control-label">Título</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label">Descrição</label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">Categoria</label>
                @Html.DropDownList("categoryId", (SelectList)ViewBag.CategoryList, "-- Selecionar --", new { @class = "form-control" })
            </div>
            <div class="form-group">
                <label asp-for="RegistrationDate" class="control-label">Data de Registro</label>
                <input asp-for="RegistrationDate" class="form-control" />
                <span asp-validation-for="RegistrationDate" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <label class="control-label">Adicionar Imagens</label>
                <input type="file" name="images" accept="image/*" multiple class="form-control" />
            </div>
            @if (Model.DonationImages != null && Model.DonationImages.Any())
            {
                <div class="form-group mt-3">
                    <label class="control-label">Imagens anexadas</label>
                    <div class="d-flex flex-wrap">
                        @foreach (var img in Model.DonationImages)
                        {
                            <div class="me-2 mb-2 text-center">
                                <img src="data:@img.ContentType;base64,@System.Convert.ToBase64String(img.ImageData)" style="width:100px;height:100px;object-fit:cover;display:block;border:1px solid #ddd;padding:2px;" />
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="removeImageIds" value="@img.DonationImageId" id="rm@img.DonationImageId" />
                                    <label class="form-check-label" for="rm@img.DonationImageId">Remover</label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            <div class="form-group mt-3">
                <input type="submit" value="Salvar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="MyDonations">Voltar para Minhas Doações</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
