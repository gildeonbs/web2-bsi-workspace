@model EloDoacoes.Models.Donation

@{
    ViewData["Title"] = "Cadastrar Doação";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-primary mb-1">Cadastrar Doação</h1>
            <p class="text-secondary mb-0">Preencha os dados abaixo para publicar uma nova doação no sistema.</p>
        </div>
        <a asp-action="MyDonations" class="btn btn-outline-primary">
            Voltar para Minhas Doações
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm rounded-3 p-4 p-md-5">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold text-dark">Título da Doação</label>
                        <input asp-for="Title" class="form-control shadow-sm" placeholder="Ex: Livros de Matemática, Cesta Básica..." />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold text-dark">Descrição Completa</label>
                        <textarea asp-for="Description" class="form-control shadow-sm" rows="4" placeholder="Descreva o estado do item, quantidades e detalhes adicionais..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">Categoria</label>
                        @Html.DropDownList("categoryId", (SelectList)ViewBag.CategoryList, "-- Selecionar Categoria --", new { @class = "form-control shadow-sm" })
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold text-dark">Imagens da Doação (Opcional)</label>
                        <input type="file" name="images" accept="image/*" multiple class="form-control shadow-sm" />
                        <div class="form-text small text-muted">Você pode selecionar várias fotos para enriquecer o anúncio.</div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="MyDonations" class="btn btn-outline-secondary px-4">
                            Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary px-5 fw-bold shadow-sm">
                            Publicar Doação
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
