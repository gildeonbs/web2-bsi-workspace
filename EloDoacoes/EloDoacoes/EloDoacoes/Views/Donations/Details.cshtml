@model EloDoacoes.Models.Donation
@using System.Linq
@using System.Security.Claims
@using EloDoacoes.Models

@{
    ViewData["Title"] = Model.Title ?? "Detalhes da Doação";
    var currentUserIdClaim = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    int.TryParse(currentUserIdClaim, out int currentUserId);
    bool isOwner = Model.User != null && Model.User.UserID == currentUserId;
    bool isAvailable = Model.DonationStatus != null && (Model.DonationStatus.Name == DonationStatusNameEnum.Available || Model.DonationStatus.Name == DonationStatusNameEnum.Reserved);
    bool isCompleted = Model.DonationStatus != null && Model.DonationStatus.Name == DonationStatusNameEnum.Completed;
    bool hasReserved = Model.Reservations != null && Model.Reservations.Any(r => r.User != null && r.User.UserID == currentUserId && r.ReservationStatus != null && (r.ReservationStatus.Name == ReservationStatusNameEnum.Pending || r.ReservationStatus.Name == ReservationStatusNameEnum.Confirmed));
    bool hasActiveReservations = Model.Reservations != null && Model.Reservations.Any(r => r.ReservationStatus == null || r.ReservationStatus.Name != ReservationStatusNameEnum.Cancelled);
    bool canEdit = !isCompleted && !hasActiveReservations;
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-primary mb-1">@Model.Title</h1>
            <p class="text-secondary mb-0">Confira todas as informações detalhadas e fotos deste item.</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">
            Voltar ao Feed
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    <div class="row g-5">
        @* Left Column: Photo Gallery *@
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-4">
                @if (Model.DonationImages != null && Model.DonationImages.Any())
                {
                    var images = Model.DonationImages.OrderBy(i => i.DisplayOrder).ToList();
                    var firstImg = images.First();
                    <div class="position-relative bg-dark text-center">
                        <img id="mainDonationImage" src="data:@firstImg.ContentType;base64,@System.Convert.ToBase64String(firstImg.ImageData)" class="w-100" style="max-height: 500px; object-fit: contain; transition: opacity 0.2s ease-in-out;" alt="@Model.Title" />
                    </div>

                    @if (images.Count > 1)
                    {
                        <div class="card-body bg-light p-3">
                            <h6 class="text-muted mb-3">Clique para expandir as fotos (@images.Count disponíveis)</h6>
                            <div class="row g-2">
                                @for (int idx = 0; idx < images.Count; idx++)
                                {
                                    var img = images[idx];
                                    var activeClass = idx == 0 ? "border-primary border-3 opacity-100" : "border-secondary opacity-75";
                                    <div class="col-3 col-sm-2">
                                        <img src="data:@img.ContentType;base64,@System.Convert.ToBase64String(img.ImageData)" 
                                             class="img-fluid rounded border shadow-sm w-100 gallery-thumbnail @activeClass" 
                                             style="height: 80px; object-fit: cover; cursor: pointer; transition: all 0.2s ease;" 
                                             onclick="switchMainImage(this.src, this)"
                                             alt="@img.FileName" />
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="bg-light text-center p-5">
                        <img src="~/images/default-donation.svg" style="max-height: 300px; object-fit: contain;" alt="Sem imagem" />
                    </div>
                }
            </div>
        </div>

        @* Right Column: Details & Donor Info *@
        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm rounded-3 p-4 mb-4">
                @{
                    string detailsStatusClass = "bg-success text-white";
                    string detailsStatusText = "Disponível";
                    if (Model.DonationStatus?.Name == EloDoacoes.Models.DonationStatusNameEnum.Reserved)
                    {
                        detailsStatusClass = "bg-warning text-dark";
                        detailsStatusText = "Reservado";
                    }
                    else if (Model.DonationStatus?.Name == EloDoacoes.Models.DonationStatusNameEnum.Completed)
                    {
                        detailsStatusClass = "bg-info text-white";
                        detailsStatusText = "Concluído";
                    }
                    else if (Model.DonationStatus?.Name == EloDoacoes.Models.DonationStatusNameEnum.Cancelled)
                    {
                        detailsStatusClass = "bg-secondary text-white";
                        detailsStatusText = "Cancelado";
                    }
                }
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <span class="badge bg-primary px-3 py-2">@(Model.Category?.Name ?? "Geral")</span>
                    <span class="badge @detailsStatusClass px-3 py-2">Status: <strong>@detailsStatusText</strong></span>
                </div>

                <h2 class="fw-bold text-primary mb-3">@Model.Title</h2>

                <p class="text-muted small mb-4">
                    Cadastrado em @Model.RegistrationDate.ToString("dd/MM/yyyy")
                </p>

                <h5 class="fw-bold mb-2">Descrição</h5>
                <p class="text-secondary mb-4" style="white-space: pre-line;">@Model.Description</p>

                <hr class="my-4" />

                <h5 class="fw-bold mb-3">Informações do Doador</h5>
                <div class="bg-light p-3 rounded-3 mb-4">
                    @if (Model.User != null)
                    {
                        var donorDisplayName = string.IsNullOrWhiteSpace(Model.User.Name) 
                            ? (User?.Identity?.IsAuthenticated == true ? Model.User.Email : "Usuário Doador") 
                            : Model.User.Name;
                        <p class="mb-1"><strong>Doador:</strong> @donorDisplayName</p>

                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            @if (!string.IsNullOrWhiteSpace(Model.User.Phone))
                            {
                                var rawPhone = new string(Model.User.Phone.Where(char.IsDigit).ToArray());
                                <p class="mb-1">
                                    <strong>WhatsApp / Telefone:</strong> 
                                    <a href="https://wa.me/55@(rawPhone)" target="_blank" class="text-success fw-bold text-decoration-none">
                                        @Model.User.Phone
                                    </a>
                                </p>
                            }
                            <p class="mb-0"><strong>E-mail:</strong> <a href="mailto:@Model.User.Email">@Model.User.Email</a></p>
                        }
                        else
                        {
                            <div class="alert alert-warning mt-3 mb-0 py-2 small d-flex flex-wrap align-items-center justify-content-between gap-2">
                                <span><i class="bi bi-lock-fill me-1"></i> Para visualizar o telefone e e-mail de contato do doador, faça login em sua conta.</span>
                                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-sm btn-outline-dark fw-bold">Entrar</a>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="mb-0 text-muted">Informação de contato não disponível.</p>
                    }
                </div>

                @* Action Buttons & Owner Approval Section *@
                <div>
                    @if (isOwner)
                    {
                        <div class="alert alert-secondary mb-3 text-center">Esta é uma doação cadastrada por você.</div>
                        @if (isCompleted)
                        {
                            <div class="alert alert-info mb-3 text-center small">
                                <i class="bi bi-lock-fill me-1"></i> Esta doação foi <strong>Concluída</strong> e as opções de edição e exclusão estão bloqueadas.
                            </div>
                        }
                        else if (hasActiveReservations)
                        {
                            <div class="alert alert-warning mb-3 text-center small">
                                <i class="bi bi-lock-fill me-1"></i> A edição está bloqueada porque há reservas ativas. Apenas doações sem reservas ou com todas as reservas canceladas podem ser editadas.
                            </div>
                        }
                        <div class="d-flex flex-wrap gap-2 mb-4">
                            @if (!canEdit)
                            {
                                string editTitle = isCompleted ? "Doação concluída não pode ser editada" : "Doação com reservas ativas não pode ser editada";
                                <button type="button" class="btn btn-secondary flex-grow-1 py-2 fw-bold" disabled title="@editTitle">
                                    <i class="bi bi-lock-fill me-1"></i> Editar Doação
                                </button>
                            }
                            else
                            {
                                <a asp-controller="Donations" asp-action="Edit" asp-route-id="@Model.DonationID" class="btn btn-warning flex-grow-1 py-2 fw-bold">
                                    Editar Doação
                                </a>
                            }
                            @if (isCompleted)
                            {
                                <button type="button" class="btn btn-secondary flex-grow-1 py-2 fw-bold" disabled title="Doação concluída não pode ser excluída">
                                    <i class="bi bi-lock-fill me-1"></i> Excluir Doação
                                </button>
                            }
                            else
                            {
                                <a asp-controller="Donations" asp-action="Delete" asp-route-id="@Model.DonationID" class="btn btn-danger flex-grow-1 py-2 fw-bold">
                                    Excluir Doação
                                </a>
                            }
                            @if (isAvailable)
                            {
                                <form asp-controller="Donations" asp-action="CompleteDonation" method="post" class="flex-grow-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="donationId" value="@Model.DonationID" />
                                    <button type="submit" class="btn btn-success w-100 py-2 fw-bold" onclick="return confirm('Deseja marcar esta doação como Concluída? Isso irá confirmar as reservas pendentes.');">
                                        Concluir Doação
                                    </button>
                                </form>
                            }
                        </div>

                        @* SECTION: List of interested users for owner approval *@
                        <div class="card border shadow-sm rounded-3 p-3 bg-light">
                            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                                <h5 class="fw-bold text-dark mb-0">
                                    Lista de Interessados (@(Model.Reservations?.Count ?? 0))
                                </h5>
                                @if (hasActiveReservations && !isCompleted)
                                {
                                    <form asp-controller="Donations" asp-action="RejectAllReservations" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="donationId" value="@Model.DonationID" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm fw-bold shadow-sm" onclick="return confirm('Deseja recusar todas as reservas ativas? Isso liberará a doação para edição novamente.');">
                                            <i class="bi bi-x-circle me-1"></i> Recusar Todas as Reservas
                                        </button>
                                    </form>
                                }
                            </div>
                            @if (Model.Reservations != null && Model.Reservations.Any())
                            {
                                <div class="list-group">
                                    @foreach (var res in Model.Reservations.OrderByDescending(r => r.ReservationDate))
                                    {
                                        var statusBadge = "bg-warning text-dark";
                                        var statusLabel = "Pendente";
                                        if (res.ReservationStatus?.Name == ReservationStatusNameEnum.Confirmed)
                                        {
                                            statusBadge = "bg-success text-white";
                                            statusLabel = "Aprovado";
                                        }
                                        else if (res.ReservationStatus?.Name == ReservationStatusNameEnum.Cancelled)
                                        {
                                            statusBadge = "bg-secondary text-white";
                                            statusLabel = "Cancelado";
                                        }

                                        <div class="list-group-item d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                                            <div>
                                                <strong>@(res.User?.Name ?? (User?.Identity?.IsAuthenticated == true ? res.User?.Email : "Usuário Interessado"))</strong>
                                                @if (User?.Identity?.IsAuthenticated == true)
                                                {
                                                    @if (!string.IsNullOrWhiteSpace(res.User?.Phone))
                                                    {
                                                        var rawResPhone = new string(res.User.Phone.Where(char.IsDigit).ToArray());
                                                        <div class="small">
                                                            <span class="text-muted">WhatsApp:</span>
                                                            <a href="https://wa.me/55@(rawResPhone)" target="_blank" class="text-success fw-bold text-decoration-none">@res.User.Phone</a>
                                                        </div>
                                                    }
                                                    <div class="small text-muted">E-mail: @res.User?.Email</div>
                                                }
                                                <div class="small text-muted">Data: @res.ReservationDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                                <span class="badge @statusBadge mt-1">@statusLabel</span>
                                            </div>

                                            @if (!isCompleted && res.ReservationStatus?.Name != ReservationStatusNameEnum.Cancelled)
                                            {
                                                <div class="d-flex flex-wrap gap-2">
                                                    @if (res.ReservationStatus?.Name == ReservationStatusNameEnum.Pending)
                                                    {
                                                        <form asp-controller="Donations" asp-action="ApproveReservation" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="reservationId" value="@res.ReservationID" />
                                                            <button type="submit" class="btn btn-success btn-sm fw-bold px-3 shadow-sm" onclick="return confirm('Aprovar doação para @(res.User?.Name ?? res.User?.Email)? Isso irá concluir a doação e retirá-la do feed.');">
                                                                Aprovar Usuário
                                                            </button>
                                                        </form>
                                                    }
                                                    <form asp-controller="Donations" asp-action="RejectReservation" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="reservationId" value="@res.ReservationID" />
                                                        <button type="submit" class="btn btn-outline-danger btn-sm fw-bold px-3 shadow-sm" onclick="return confirm('Recusar a reserva de @(res.User?.Name ?? res.User?.Email)?');">
                                                            Recusar
                                                        </button>
                                                    </form>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-muted small mb-0">Nenhum usuário demonstrou interesse nesta doação ainda.</p>
                            }
                        </div>
                    }
                    else if (hasReserved)
                    {
                        <button class="btn btn-secondary btn-lg w-100 py-3" disabled>
                            Você já reservou esta doação
                        </button>
                    }
                    else if (isAvailable)
                    {
                        <form asp-controller="Donations" asp-action="Reserve" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="donationId" value="@Model.DonationID" />
                            <button type="submit" class="btn btn-primary btn-lg w-100 py-3 fw-bold shadow-sm">
                                Reservar Doação
                            </button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-lg w-100 py-3" disabled>
                            Doação @(Model.DonationStatus?.Name.ToString() ?? "Concluída")
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function switchMainImage(src, element) {
            var mainImg = document.getElementById('mainDonationImage');
            if (mainImg) {
                mainImg.style.opacity = '0.3';
                setTimeout(function () {
                    mainImg.src = src;
                    mainImg.style.opacity = '1';
                }, 150);
            }
            var thumbnails = document.querySelectorAll('.gallery-thumbnail');
            thumbnails.forEach(function (thumb) {
                thumb.classList.remove('border-primary', 'border-3');
                thumb.classList.add('border-secondary', 'opacity-75');
            });
            if (element) {
                element.classList.remove('border-secondary', 'opacity-75');
                element.classList.add('border-primary', 'border-3');
            }
        }
    </script>
}
