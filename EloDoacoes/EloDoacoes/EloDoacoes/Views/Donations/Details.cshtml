@model EloDoacoes.Models.Donation

@using System.Linq

@{
    ViewData["Title"] = "Detalhes";
}

<h1>Detalhes</h1>

<div>
    <h4>Doação</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">Título</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.Title)</dd>

        <dt class = "col-sm-2">Descrição</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.Description)</dd>

        <dt class = "col-sm-2">Data de Registro</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.RegistrationDate)</dd>

        <dt class = "col-sm-2">Imagens</dt>
        <dd class = "col-sm-10">
            @if (Model.DonationImages != null && Model.DonationImages.Any())
            {
                <div class="donation-images">
                    @foreach (var img in Model.DonationImages.OrderBy(i => i.DisplayOrder))
                    {
                        if (img?.ImageData != null && img.ImageData.Length > 0)
                        {
                            <img src="data:@img.ContentType;base64,@System.Convert.ToBase64String(img.ImageData)" alt="@img.FileName" style="max-width:200px; max-height:200px; margin-right:8px; margin-bottom:8px;" />
                        }
                    }
                </div>
            }
            else
            {
                <p class="text-muted">Nenhuma imagem anexada.</p>
            }
        </dd>

        <dt class="col-sm-2">Reservas</dt>
        <dd class="col-sm-10">
            <table class="table">
                <tr>
                    <th>Status da Reserva</th>
                    <th>Data da Reserva</th>
                </tr>
                @if (Model.Reservations != null)
                {
                    foreach (var item in Model.Reservations)
                    {
                        <tr>
                            <td>@Html.DisplayFor(_ => item.ReservationStatus.Name)</td>
                            <td>@Html.DisplayFor(_ => item.ReservationDate)</td>
                        </tr>
                    }
                }
            </table>
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.DonationID">Editar</a> |
    <a asp-action="Index">Voltar para a Lista</a>
</div>
